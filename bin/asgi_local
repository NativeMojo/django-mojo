#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
TESTPROJECT="$REPO_ROOT/testproject"

# Load .env from repo root if present (secrets like LLM_HANDLER_API_KEY)
if [ -f "$REPO_ROOT/.env" ]; then
    set -a
    source "$REPO_ROOT/.env"
    set +a
fi

# Isolate the test server from the developer's real AWS (maestro #2789).
# Env credentials are the FIRST leg of boto's chain and .env was just sourced,
# so clear them; a stale AWS_PROFILE would raise ProfileNotFound rather than
# fall through, so it goes too. /dev/null parses as an empty ini. Tests seed
# AWS access through mojo-level Setting rows — the ambient chain must never
# supply real credentials to a test process.
export AWS_SHARED_CREDENTIALS_FILE=/dev/null
export AWS_CONFIG_FILE=/dev/null
export AWS_EC2_METADATA_DISABLED=true
unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_PROFILE AWS_DEFAULT_PROFILE 2>/dev/null || true
# Container (ECS/Fargate) and web-identity (IRSA) chain legs need no config
# file and are not IMDS — clear them too or a CI runner still resolves creds.
unset AWS_CONTAINER_CREDENTIALS_RELATIVE_URI AWS_CONTAINER_CREDENTIALS_FULL_URI AWS_CONTAINER_AUTHORIZATION_TOKEN AWS_WEB_IDENTITY_TOKEN_FILE AWS_ROLE_ARN 2>/dev/null || true

# Use venv Python if available
if [ -f "$REPO_ROOT/.venv/bin/python" ]; then
    PYTHON="$REPO_ROOT/.venv/bin/python"
else
    PYTHON="python3"
fi

PIDFILE="$TESTPROJECT/var/asgi.pid"
LOGFILE="$TESTPROJECT/var/asgi.log"

_check_project() {
    if [ ! -d "$TESTPROJECT" ]; then
        echo "ERROR: testproject/ not found. Run ./bin/create_testproject first."
        exit 1
    fi
    mkdir -p "$TESTPROJECT/var"
}

_ensure_redis() {
    # Look for redis-cli in PATH, then common Homebrew locations
    REDIS_CLI="redis-cli"
    REDIS_SERVER="redis-server"
    for dir in /opt/homebrew/bin /usr/local/bin; do
        if [ -x "$dir/redis-cli" ]; then
            REDIS_CLI="$dir/redis-cli"
            REDIS_SERVER="$dir/redis-server"
            break
        fi
    done

    if ! "$REDIS_CLI" ping > /dev/null 2>&1; then
        echo "==> Starting redis-server in background"
        "$REDIS_SERVER" --daemonize yes
    fi
}

_read_conf() {
    HOST="127.0.0.1"
    PORT="5555"
    CONF="$TESTPROJECT/config/dev_server.conf"
    # var/ override wins when present (gitignored, per-machine); else fall back to config/.
    if [ -f "$TESTPROJECT/var/dev_server.conf" ]; then
        CONF="$TESTPROJECT/var/dev_server.conf"
    fi
    if [ -f "$CONF" ]; then
        while IFS='=' read -r key value; do
            key=$(echo "$key" | tr -d '[:space:]')
            value=$(echo "$value" | tr -d '[:space:]')
            case "$key" in
                host) HOST="$value" ;;
                port) PORT="$value" ;;
            esac
        done < "$CONF"
    fi
    export DJANGO_SETTINGS_MODULE=settings
    export PYTHONUNBUFFERED=1
}

_is_running() {
    if [ -f "$PIDFILE" ]; then
        pid=$(cat "$PIDFILE")
        if kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
        # stale pid file
        rm -f "$PIDFILE"
    fi
    return 1
}

_run_migrations() {
    echo "==> Running migrations"
    # If django_migrations is empty (e.g. after test flush), fake first then apply real
    EMPTY=$( DJANGO_SETTINGS_MODULE=settings PYTHONPATH="$TESTPROJECT/config:$REPO_ROOT" \
        $PYTHON -c "
import django; django.setup()
from django.db import connection
c = connection.cursor()
c.execute('SELECT COUNT(*) FROM django_migrations')
print(c.fetchone()[0])
" 2>/dev/null || echo "0" )

    if [ "$EMPTY" = "0" ]; then
        echo "    Migration tracker empty — faking existing then applying new"
        DJANGO_SETTINGS_MODULE=settings PYTHONPATH="$TESTPROJECT/config:$REPO_ROOT" \
            $PYTHON -m django migrate --fake --settings=settings --no-input 2>&1 | tail -3
        DJANGO_SETTINGS_MODULE=settings PYTHONPATH="$TESTPROJECT/config:$REPO_ROOT" \
            $PYTHON -m django makemigrations --settings=settings --no-input 2>&1 | tail -3
        DJANGO_SETTINGS_MODULE=settings PYTHONPATH="$TESTPROJECT/config:$REPO_ROOT" \
            $PYTHON -m django migrate --settings=settings --no-input 2>&1 | tail -3
    else
        # Fast path: the tracker has rows, a plain migrate is usually a no-op.
        # If it fails (a model edit without bin/create_testproject, or tracker
        # rows for migration files a branch switch removed), fall back to the
        # rebuild path instead of hard-failing — the wipe-every-run behavior
        # this replaced healed such drift by accident (maestro #2789).
        if ! DJANGO_SETTINGS_MODULE=settings PYTHONPATH="$TESTPROJECT/config:$REPO_ROOT" \
            $PYTHON -m django migrate --settings=settings --no-input \
            > "$TESTPROJECT/var/migrate.log" 2>&1; then
            echo "    migrate failed — rebuilding (fake existing, makemigrations, migrate)"
            tail -5 "$TESTPROJECT/var/migrate.log"
            DJANGO_SETTINGS_MODULE=settings PYTHONPATH="$TESTPROJECT/config:$REPO_ROOT" \
                $PYTHON -m django migrate --fake --settings=settings --no-input 2>&1 | tail -3
            DJANGO_SETTINGS_MODULE=settings PYTHONPATH="$TESTPROJECT/config:$REPO_ROOT" \
                $PYTHON -m django makemigrations --settings=settings --no-input 2>&1 | tail -3
            echo "    NOTE: makemigrations may have written files under mojo/*/migrations/ —"
            echo "    review with git status before committing (see .claude/rules/git.md)."
            DJANGO_SETTINGS_MODULE=settings PYTHONPATH="$TESTPROJECT/config:$REPO_ROOT" \
                $PYTHON -m django migrate --settings=settings --no-input 2>&1 | tail -3
        else
            tail -5 "$TESTPROJECT/var/migrate.log"
        fi
    fi
}

do_wait() {
    # Poll until the server answers HTTP (maestro #2789). Reuses _read_conf so
    # the per-machine var/dev_server.conf override wins, exactly as the server
    # itself resolves it. Any HTTP response counts (no -f): a 404 proves the
    # app is serving; connection-refused and a supervisor that has bound the
    # socket but not loaded the app both keep polling. 30s cap, fail loudly.
    _check_project
    _read_conf
    for i in $(seq 1 300); do
        if curl -s -o /dev/null --max-time 2 "http://$HOST:$PORT/"; then
            return 0
        fi
        sleep 0.1
    done
    echo "ERROR: server did not answer on http://$HOST:$PORT within 30s" >&2
    return 1
}

do_start() {
    _check_project
    _ensure_redis
    _read_conf

    if _is_running; then
        echo "Already running (PID $(cat "$PIDFILE"))"
        exit 0
    fi

    _run_migrations

    echo "==> Starting uvicorn on http://$HOST:$PORT (daemon)"
    nohup $PYTHON -m uvicorn _asgi:application \
        --app-dir "$TESTPROJECT/bin" \
        --host "$HOST" \
        --port "$PORT" \
        --reload \
        --reload-include '*.conf' \
        > "$LOGFILE" 2>&1 &

    echo $! > "$PIDFILE"
    echo "Started (PID $!, log: $LOGFILE)"
}

do_stop() {
    if ! _is_running; then
        echo "Not running"
        return 0
    fi
    pid=$(cat "$PIDFILE")
    echo "==> Stopping uvicorn (PID $pid)"
    kill "$pid" 2>/dev/null || true
    # wait up to 5s for graceful shutdown
    for i in $(seq 1 10); do
        if ! kill -0 "$pid" 2>/dev/null; then
            break
        fi
        sleep 0.5
    done
    # force kill if still alive
    if kill -0 "$pid" 2>/dev/null; then
        kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f "$PIDFILE"
    echo "Stopped"
}

do_status() {
    if _is_running; then
        echo "Running (PID $(cat "$PIDFILE"))"
    else
        echo "Not running"
    fi
}

do_foreground() {
    _check_project
    _ensure_redis
    _read_conf
    _run_migrations

    if _is_running; then
        echo "WARNING: daemon already running (PID $(cat "$PIDFILE")), starting foreground anyway"
    fi

    echo "==> Starting uvicorn on http://$HOST:$PORT"
    exec $PYTHON -m uvicorn _asgi:application \
        --app-dir "$TESTPROJECT/bin" \
        --host "$HOST" \
        --port "$PORT" \
        --reload \
        --reload-include '*.conf'
}

case "${1:-}" in
    start)   do_start ;;
    stop)    do_stop ;;
    restart) do_stop; do_start ;;
    status)  do_status ;;
    wait)    do_wait ;;
    "")      do_foreground ;;
    *)
        echo "Usage: asgi_local [start|stop|restart|status|wait]"
        echo "  (no args)  Run in foreground"
        echo "  start      Run as background daemon"
        echo "  stop       Stop the daemon"
        echo "  restart    Restart the daemon"
        echo "  status     Check if running"
        echo "  wait       Block until the server answers HTTP (30s cap)"
        exit 1
        ;;
esac

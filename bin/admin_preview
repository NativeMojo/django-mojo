#!/usr/bin/env python3
"""Loopback-only visual fixture for the built-in Admin portal.

Serves the exact packaged HTML/CSS/JS with deterministic API responses. This
is deliberately outside Django and has no production route or auth bypass.
"""

import json
import mimetypes
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import urlparse


ROOT = Path(__file__).resolve().parents[1] / "mojo/apps/account/admin_portal"
HOST = "127.0.0.1"
PORT = 5608

USERS = [
    {"id": 1, "display_name": "Ian Smith", "email": "ian@example.com", "username": "ian@example.com", "is_active": True, "created": "2026-07-12T18:10:00Z"},
    {"id": 2, "display_name": "Avery Chen", "email": "avery@example.com", "username": "avery@example.com", "is_active": True, "created": "2026-07-27T09:30:00Z"},
    {"id": 3, "display_name": "Morgan Lee", "email": "morgan@example.com", "username": "morgan@example.com", "is_active": False, "created": "2026-06-03T14:20:00Z"},
]
GROUPS = [
    {"id": 7, "name": "MOJO Platform", "kind": "organization", "is_active": True},
    {"id": 9, "name": "Web Operations", "kind": "team", "is_active": True},
]
WEBAPPS = [
    {"id": 42, "slug": "mojo-portal", "created": "2026-07-19T10:00:00Z", "current_release": {"id": 18, "version": "8d42ea1"}},
    {"id": 54, "slug": "docs", "created": "2026-07-30T16:40:00Z", "current_release": None},
]


class PreviewHandler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        return

    def _send(self, body, content_type="application/json", status=200):
        if isinstance(body, (dict, list)):
            body = json.dumps({"status": True, "data": body}, default=str).encode()
        elif isinstance(body, str):
            body = body.encode()
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _api(self, path):
        if path == "/api/account/static/mojo-auth.js":
            return self._send(
                "window.MojoAuth={init:function(){},getAuthHeader:function(){return 'Bearer preview';},getRefreshToken:function(){return null;},logout:function(){}};",
                "application/javascript; charset=utf-8")
        if path == "/api/account/admin/bootstrap":
            return self._send({
                "version": "1.9.0", "admin_path": "/", "groups": GROUPS,
                "user": {"id": 1, "display_name": "Ian Smith", "email": "ian@example.com", "is_superuser": True},
                "capabilities": {"setup": True, "people": True, "groups": True, "webapps": True, "manage_webapps": True},
            })
        if path == "/api/account/admin/setup/readiness":
            return self._send({
                "schema_version": 1, "overall": "warn",
                "summary": {"pass": 5, "warn": 1, "fail": 0, "pending": 0},
                "sections": [{
                    "code": "django", "label": "Django installation", "status": "warn",
                    "checks": [
                        {"code": "django.apps", "status": "pass", "explanation": "Django applications loaded successfully.", "remediation": "", "fixable": False},
                        {"code": "django.database", "status": "pass", "explanation": "The database answered a query.", "remediation": "", "fixable": False},
                        {"code": "django.base_url", "status": "warn", "explanation": "The public hostname is ready for final verification.", "remediation": "Rerun after DNS propagation completes.", "fixable": True},
                    ],
                }],
            })
        if path == "/api/user":
            return self._send(USERS)
        if path == "/api/group":
            return self._send(GROUPS)
        if path == "/api/edge/webapp":
            return self._send(WEBAPPS)
        if path == "/api/edge/webapp/key_status":
            return self._send({"webapp": 42, "secret_name": "MOJO_DEPLOY_KEY", "status": {"linked": True, "active": True, "api_key": 91, "name": "webapp:mojo-portal", "created": "2026-07-20T12:00:00Z", "last_used": "2026-08-09T22:14:00Z"}})
        return self._send({"error": "Not found"}, status=404)

    def do_GET(self):
        parsed = urlparse(self.path)
        path = parsed.path
        if path.startswith("/api/"):
            return self._api(path)
        if path in ("/", "/admin", "/admin/"):
            target = ROOT / "index.html"
        else:
            relative = path.removeprefix("/admin/").lstrip("/")
            target = (ROOT / relative).resolve()
            if ROOT.resolve() not in target.parents:
                return self._send("Not found", "text/plain", 404)
        if not target.is_file():
            return self._send("Not found", "text/plain", 404)
        content_type = mimetypes.guess_type(target.name)[0] or "application/octet-stream"
        self._send(target.read_bytes(), content_type)

    def do_POST(self):
        path = urlparse(self.path).path
        size = int(self.headers.get("Content-Length", "0"))
        if size:
            self.rfile.read(size)
        if path == "/api/edge/webapp/link_key":
            return self._send({"webapp": 42, "secret_name": "MOJO_DEPLOY_KEY", "replayed": False, "operation_id": "preview", "token": "preview-token-shown-once", "status": {"linked": True, "active": True}})
        if path == "/api/edge/webapp/revoke_key":
            return self._send({"webapp": 42, "secret_name": "MOJO_DEPLOY_KEY", "replayed": False, "operation_id": "preview", "status": {"linked": False, "active": False}})
        if path == "/api/account/admin/setup/create":
            return self._send({"id": "preview-setup", "mode": "fix", "status": "planned", "cursor": 0, "steps": [{"id": "installation_identity", "version": 1, "label": "Freeze installation identity", "state": "planned"}], "current_step": {"id": "installation_identity", "version": 1, "label": "Freeze installation identity", "state": "planned"}, "log": []})
        if path == "/api/account/admin/setup/advance":
            return self._send({"id": "preview-setup", "mode": "fix", "status": "reconciling", "cursor": 0, "steps": [{"id": "installation_identity", "version": 1, "label": "Freeze installation identity", "state": "reconciling"}], "current_step": {"id": "installation_identity", "version": 1, "label": "Freeze installation identity", "state": "reconciling"}, "log": [{"at": "2026-08-10T03:00:00Z", "message": "Reconciling installation_identity"}]})
        if path in ("/api/account/admin/setup/choose", "/api/account/admin/setup/cancel"):
            return self._send({"id": "preview-setup", "mode": "fix", "status": "cancelled", "cursor": 0, "steps": [], "current_step": None, "log": []})
        return self._send({"saved": True})


if __name__ == "__main__":
    print(f"Admin visual fixture: http://{HOST}:{PORT}/")
    try:
        ThreadingHTTPServer((HOST, PORT), PreviewHandler).serve_forever()
    except KeyboardInterrupt:
        pass
